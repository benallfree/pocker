{
  "name": "pocketpages-starter-daisyui-docs",
  "private": true,
  "description": "A starter project for PocketPages with DaisyUI and Docs (Tailwind CSS build only; PocketPages itself needs no npm install)",
  "scripts": {
    "dev:css": "tailwindcss -i ./pb_pages/assets/app.tailwind.css -o ./pb_pages/assets/app.css --watch",
    "build:css": "tailwindcss -i ./pb_pages/assets/app.tailwind.css -o ./pb_pages/assets/app.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "daisyui": "^4.12.23",
    "tailwindcss": "^3.4.17"
  },
  "license": "MIT"
}
