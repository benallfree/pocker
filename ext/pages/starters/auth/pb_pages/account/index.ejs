<h2>Account</h2>
<p>Welcome, <%= ctx.auth.email() %></p>
<p>Status: <%= ctx.auth.verified() ? 'verified' : 'unverified' %></p>
<div>Account tools</div>
<ul>
  <li><a href="/account/change-email">Change email address</a></li>
  <li><a href="/auth/forgot">Change password</a> (by email)</li>
  <% if (!ctx.auth.verified()) { %><li><a href="/auth/verify">Resend verification email</a></li><% } %>
</ul>
