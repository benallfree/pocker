<h2>Change Email</h2>

<div>
  Current email: <%= ctx.auth.email() %>
</div>

<% if (data.error) { %>
<mark><%= data.error %></mark>
<% } %>
<form action="/account/change-email" method="post">
  <input type="email" name="email" placeholder="New email address" value="<%= data.email || '' %>" required />
  <button type="submit">Change email</button>
</form>
