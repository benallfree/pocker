<h2>Forgot Password</h2>
<% if (data.error) { %>
<mark><%= data.error %></mark>
<% } %>
<form method="post">
  <label>Email</label>
  <input name="identity" type="email" value="<%= data.identity || '' %>" required />
  <button type="submit">Send Reset Email</button>
</form>
<p><a href="/auth/login">Back to sign in</a></p>
