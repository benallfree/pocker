<h2>Register</h2>
<% if (data.error) { %>
<div><mark><%= data.error %></mark></div>
<% } %>
<form method="post">
  <label>Username</label>
  <input name="identity" value="<%= data.identity %>" />
  <label>Password</label>
  <input name="password" type="password" value="<%= data.password %>" />
  <button type="submit">Login</button>
</form>
